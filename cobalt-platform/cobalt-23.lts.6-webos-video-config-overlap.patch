   // If we don't have buffered data to seek to, then return.
   if (seek_timestamp == kNoTimestamp) {
+#if defined(STARBOARD_WEBOS)
+    // An adaptive config change can replace the exhausted GOP after its first
+    // frames were returned. Searching only after the last output PTS misses
+    // the replacement keyframe, leaving reads pending despite buffered data.
+    // Resume the new config from its preceding keyframe; rendering discards
+    // preroll before the current presentation time. This also runs when old
+    // frames saved in track_buffer_ drain after an overlapping append.
+    if (!video_configs_.empty() && !seek_pending_ &&
+        highest_output_buffer_timestamp_ != kNoTimestamp) {
+      auto replacement = FindExistingRangeFor(highest_output_buffer_timestamp_);
+      if (replacement != ranges_.end() &&
+          (*replacement)->CanSeekTo(highest_output_buffer_timestamp_) &&
+          (*replacement)->GetConfigIdAtTime(highest_output_buffer_timestamp_) !=
+              current_config_index_) {
+        SeekAndSetSelectedRange(replacement->get(),
+                                highest_output_buffer_timestamp_);
+      }
+    }
+#endif
     DVLOG(2) << __func__ << " " << GetStreamTypeName()
              << " couldn't find new selected range seek timestamp";
     return;
