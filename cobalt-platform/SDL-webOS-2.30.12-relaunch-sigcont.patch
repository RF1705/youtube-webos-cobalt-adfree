+/* Forward launch parameters to Cobalt without depending on its C++ ABI. */
+static void sendYtafRelaunch(LSMessage *reply)
+{
+    SDL_Event event;
+    const char *payload = HELPERS_HLunaServiceMessage(reply);
+    if (!payload) return;
+    SDL_zero(event);
+    event.type = SDL_USEREVENT;
+    event.user.code = 0x59544146;
+    event.user.data1 = SDL_strdup(payload);
+    if (event.user.data1 && SDL_PushEvent(&event) <= 0) SDL_free(event.user.data1);
+}
+
