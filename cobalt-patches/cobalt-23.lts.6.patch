+void YtafFileLog(const std::string& message) {
+#if defined(YTAF_COBALT_DEBUG)
+  bool created = false;
+  SbFileError error = kSbFileOk;
+  SbFile file = SbFileOpen("/tmp/ytaf-cobalt.log",
